# The CRM talks to the admin backend, which runs on 4002 here — see
# admin-backend/.env. Without this the app falls back to a hardcoded
# localhost:4000 and every request fails with "Could not reach the server".
VITE_API_URL=http://localhost:4002/graphql

# The CRM's own dev server. Deliberately not 5174: the admin panel runs there
# and the two are meant to run side by side, not one instead of the other.
VITE_CRM_PORT=5175
