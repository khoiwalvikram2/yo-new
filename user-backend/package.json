{
  "name": "user-backend",
  "version": "0.0.1",
  "description": "User-facing GraphQL backend",
  "type": "module",
  "main": "dist/user-backend/src/index.js",
  "scripts": {
    "dev": "node --import tsx scripts/launch.mjs development ../src/index.ts",
    "build": "node scripts/build.js",
    "start": "node scripts/launch.mjs production ../dist/user-backend/src/index.js",
    "test": "node ../scripts/run-tests.mjs",
    "verify:gmag-replay": "node --import tsx scripts/gmagReplayProof.mts",
    "probe:public-surface": "tsx scripts/probePublicSurface.ts",
    "migrate:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate:push": "drizzle-kit push --config=drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node ../scripts/run-tests.mjs --integration",
    "test:all": "node ../scripts/run-tests.mjs --all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/client-sns": "^3.590.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "mercurius": "^16.5.0",
    "mqemitter-redis": "^5.0.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "twilio": "^5.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "0.31.11",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
