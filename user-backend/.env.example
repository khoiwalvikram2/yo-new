# Required application/database settings. Replace every example value.
PORT=4003
DATABASE_URL=postgresql://app_user:replace-me@127.0.0.1:5432/gw
JWT_SECRET=replace-with-at-least-32-random-characters

# Required outside development. List every exact player origin; wildcards are
# rejected at startup because this API allows credentialed browser requests.
CORS_ORIGIN=https://play.example.com,https://www.play.example.com

# When nginx is on the same host, trust only the loopback proxy. Leave false if
# the API is exposed directly; use explicit proxy CIDRs for other topologies.
TRUST_PROXY=loopback

# Public player URL used when generating referral links.
USER_APP_BASE_URL=https://play.example.com

# Internal admin API used for referral/account coordination. Keep it private.
ADMIN_BASE_URL=http://127.0.0.1:4002
INTERNAL_API_KEY=replace-with-a-separate-random-secret

# Required for production sports catalogue/odds calls. Confirm this provider
# endpoint for the deployment rather than relying on the legacy code fallback.
UPSTREAM_API_BASE_URL=https://api.gamdaddy.com
SPORTS_API_MARKET_ODDS_PATH=/get-market-odds
# SPORTS_API_FANCY_ODDS_PATH=/get-fancy-odds

# Payment provider base URL. The optional allow-list is a temporary test gate:
# unset/empty means all otherwise-eligible users are allowed in production.
WELIVEPAY_BASE_URL=https://welivepay.in
# WELIVEPAY_ALLOWED_USER_IDS=60,61
# Crypto (USDT) deposits test gate, same rule: unset/empty = every player. A list with no
# valid ID allows nobody, so a typo never opens crypto to everyone.
# CRYPTO_DEPOSIT_ALLOWED_USER_IDS=761,802

# Recommended public-endpoint abuse controls.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MIN_SECONDS_BETWEEN_SENDS=60

# Verbose GAP tracing is development-only, opt-in, and redacts sensitive fields.
GAP_DEBUG=0
