PORT=4000
# Comma-separated allowed origins. Production must include your admin UI origin, e.g.:
# CORS_ORIGIN=https://admin.grandwinn.com
CORS_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gd
# Set to false to skip TLS cert verification (e.g. if you get "self-signed certificate in certificate chain")
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=dev-secret-change
REDIS_URL=redis://localhost:6379

# AI PORTAL ASSISTANT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_TOKENS_PER_CONVERSATION=120000
AI_PROPOSAL_TTL_SECONDS=900
