# Keep production API traffic on the page's own origin. The reverse proxy must
# route /graphql and the REST endpoints on the same host to user-backend.
VITE_USER_GRAPHQL_URL=/graphql
VITE_API_BASE_URL=
VITE_ODDS_WS=https://odds.grandwinn.com
VITE_WHITELABEL_ID=
VITE_API_APP_NAME=NOVA

# The explicit empty overrides prevent development values from the base .env
# being baked into a production build. Tenant and final branding come from the
# runtime hostname and app-settings response so one build can safely serve every
# domain. NOVA is only the pre-settings document-title fallback.
