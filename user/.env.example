# Safe deploy defaults. Override in .env.local for a standalone local backend.
VITE_USER_GRAPHQL_URL=/graphql
VITE_PORT=5177

# Keep the tenant unset in a shared production build. Runtime hostname and app
# settings provide the tenant identity and final branding; NOVA is only the
# document-title fallback before settings load.
# VITE_WHITELABEL_ID=
VITE_API_APP_NAME=NOVA

# Realtime odds endpoint. The current socket hook does not read app settings, so
# set this explicitly for deployments that need live odds.
VITE_ODDS_WS=https://odds.grandwinn.com
