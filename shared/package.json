{
  "name": "@gd/shared",
  "version": "0.0.1",
  "description": "Shared types, validation, and database schemas for user/admin backends",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "seed": "tsx scripts/seedAll.ts",
    "seed:vip": "tsx scripts/seedVipTiers.ts",
    "migrate:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate:push": "drizzle-kit push --config=drizzle.config.ts",
    "migrate:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "migrate:push:yes": "tsx scripts/pushMigration.ts",
    "migrate:run": "tsx scripts/runMigration.ts",
    "migrate:director-preferences": "psql $DATABASE_URL -f drizzle/0035_add_director_admin_preferences.sql",
    "migrate:referral-rules-unique": "psql $DATABASE_URL -f drizzle/0049_referral_rules_tenant_rule_type_unique.sql",
    "migrate:agent-token-version": "psql $DATABASE_URL -f drizzle/0058_add_agent_token_version.sql",
    "migrate:reporting-snapshots-dedup": "tsx scripts/runReportingSnapshotsDedup.ts",
    "seed:whitelabel": "tsx scripts/seedWhitelabel.ts",
    "seed:roles": "tsx scripts/seedRbac.ts",
    "seed:super-admin": "tsx scripts/seedSuperAdmin.ts",
    "seed:sports": "tsx scripts/seedSports.ts",
    "seed:sports:reset": "RESET=1 tsx scripts/seedSports.ts",
    "seed:gap-casino": "tsx scripts/seedGapCasino.ts",
    "seed:gmag-casino": "tsx scripts/seedGmagCasino.ts",
    "seed:all": "tsx scripts/seedAll.ts",
    "reset:db": "tsx scripts/resetDb.ts",
    "migrate:0075-bonus-award-snapshot": "tsx scripts/runDrizzleSqlFile.ts drizzle/0075_bonus_awards_distribution_snapshot.sql",
    "migrate:0088-assets-base64": "tsx scripts/runDrizzleSqlFile.ts drizzle/0088_assets_base64_columns.sql",
    "migrate:0089-casino-callback-rejections": "tsx scripts/runDrizzleSqlFile.ts drizzle/0089_casino_callback_rejections.sql",
    "backfill:referral-balance": "tsx scripts/backfillReferralBalance.ts",
    "backfill:casino-categories": "cd ../admin-backend && npx tsx scripts/backfillCasinoCategories.ts",
    "migrate:0090-casino-callback-idempotency": "tsx scripts/runDrizzleSqlFile.ts drizzle/0090_casino_callback_idempotency.sql",
    "migrate:data-vip-audit-tenant": "tsx scripts/runDrizzleSqlFile.ts drizzle/data_0001_vip_audit_tenant_backfill.sql",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/run-tests.mjs",
    "test:integration": "node ../scripts/run-tests.mjs --integration",
    "test:all": "node ../scripts/run-tests.mjs --all"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "luxon": "^3.4.4",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "fastify": "^5.12.5",
    "@fastify/websocket": "^11.3.0",
    "mqemitter-redis": "^5.1.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
