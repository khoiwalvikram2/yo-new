# Required for seeds, reset:db, and migrations (migrate:push, runMigration)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gd

# Optional: SSL (if DATABASE_URL uses sslmode=require or production DB)
# DATABASE_CA_CERT=./certs/ca-certificate.crt
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional: Super Admin user (seed:super-admin / seed:all). If SUPER_ADMIN_PASSWORD is unset or &lt; 8 chars, a random password is generated and printed.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=

# --- Sports seed (seed:sports / seed:all). Shared-only; no admin-backend. ---
# SPORTS_API_URL=http://174.138.121.69/get-sports
# SPORTS_FETCH_TIMEOUT_MS=30000
# RESET=1

# --- Casino seed (seed:gap-casino). Needs gap-casino-games.json at repo root ---
# LIMIT=100
